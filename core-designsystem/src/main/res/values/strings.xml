    <string name="about_title">About PantryHub</string>
    <string name="about_version">Version %s</string>
    <string name="about_body">PantryHub is a shopping companion: keep your product catalog, build reusable or one-off lists, tick things off in shopping mode and jot down notes along the way.</string>
    <string name="about_privacy">Everything is stored on this device only. There are no accounts, no tracking and no ads; use Backup to move your data to another phone.</string>
    <string name="about_credits">Designed and built by Esteban Albarrán.</string>
